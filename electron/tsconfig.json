{
  "//": "Emit the main process and its shared contracts under dist, preserving relative imports.",
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "lib": ["ES2022"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": true,
    "verbatimModuleSyntax": false,
    "outDir": "../dist",
    "rootDir": "..",
    "declaration": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true
  },
  // Every main-process module, in any folder. The preload and the preview
  // client compile on their own (tsconfig.preload.json, tsconfig.morph.json):
  // one needs DOM types, the other browser ESM.
  "include": ["**/*.ts"],
  "exclude": ["preload/**", "previewClient/**"]
}
