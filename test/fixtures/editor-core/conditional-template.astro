---
const show = true;
const items = [1, 2];
const rest = {};
---
{show ? (<p class="a">Yes</p>) : (<p class="a">No</p>)}
{show && (
  <ul>{items.map((n) => <li class="a">{n}</li>)}</ul>
)}
<div
  class="multi"
  data-x={ 1 + 2 }
  {...rest}
  hidden
></div>
<div class="a" class="b" set:html={"<b>x</b>"}></div>
<p class="a" class="b">Duplicated class</p>
<!-- html comment -->
{/* jsx comment */}
{show ? <em>on</em> : show ? <strong>maybe</strong> : <span>off</span>}
