---
const items = [{ title: 'One', href: '/one' }];
const itemCount = items.length;
---
<ul class="item-list" data-count={itemCount}>
  {items.map((item) => (
    <li class="item"><a href={item.href}>{item.title}</a></li>
  ))}
</ul>
<p>Each item links somewhere.</p>
<ol>
  {items.map((item) => (
    <li>{item.title}</li>
  ))}
</ol>
