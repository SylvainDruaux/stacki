#!/usr/bin/env node
// Git runs this file; the checks live in scripts/policy/git-hooks.mts, shared
// with every agent harness. Plain JavaScript because git executes it directly.
const childProcess = require('node:child_process');
const path = require('node:path');

const entry = path.join(__dirname, '..', 'scripts/policy/git-hooks.mts');
const hookArguments = ['pre-push', ...process.argv.slice(2)];
const result = childProcess.spawnSync(process.execPath, [entry, ...hookArguments], {
  stdio: 'inherit',
});
process.exitCode = result.status ?? 1;
