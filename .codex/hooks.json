{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^(Bash|apply_patch|Edit|Write)$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-cdup)scripts/agent/codex.mts\" pre-tool",
            "statusMessage": "Checking against repository policy",
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^(apply_patch|Edit|Write)$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-cdup)scripts/agent/codex.mts\" post-tool",
            "statusMessage": "Formatting and checking the edited files",
            "timeout": 120
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-cdup)scripts/agent/codex.mts\" stop",
            "statusMessage": "Checking every changed file",
            "timeout": 300
          }
        ]
      }
    ]
  }
}
