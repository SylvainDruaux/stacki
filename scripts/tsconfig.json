{
  // Type-checks every script under the full AGENTS.md flag set, including
  // verbatimModuleSyntax, without emitting. scripts/tsconfig.build.json emits
  // CommonJS for Electron Builder, and verbatimModuleSyntax cannot hold under a
  // CommonJS emit; module "preserve" accepts both import-assignment and ESM
  // imports, so the same sources pass here. The policy tooling (eslint-plugin,
  // policy, agent) runs directly under Node type stripping and is checked here.
  "compilerOptions": {
    "target": "ES2022",
    "module": "preserve",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["**/*.ts", "**/*.mts"]
}
